{
  "rules": {
    "cards": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.child('members/a').val() === auth.uid && !newData.child('members/b').exists()",
        ".validate": "$code.matches(/^[A-HJ-NP-Z2-9]{6}$/) && newData.hasChildren(['card', 'members'])",
        "card": {
          ".write": "auth != null && (data.parent().child('members/a').val() === auth.uid || data.parent().child('members/b').val() === auth.uid)",
          ".validate": "newData.hasChildren(['base', 'updated']) && (newData.child('base').val() === 'sayc' || newData.child('base').val() === '2/1') && newData.child('updated').isNumber()",
          "name": { ".validate": "newData.isString() && newData.val().length <= 40" }
        },
        "members": {
          "a": { ".validate": "newData.isString()" },
          "b": {
            ".write": "auth != null && !data.exists() && newData.val() === auth.uid && data.parent().child('a').val() !== auth.uid",
            ".validate": "newData.isString()"
          },
          "$other": { ".validate": false }
        },
        "created": { ".validate": "newData.isNumber()" }
      }
    }
  }
}
